{% extends 'blades/html.njk' %}

{% if not site.prod %}
  {% set site = site | attr_set('styles', site.styles | join('|') | replace('https://cdn.jsdelivr.net/npm/@anyblades/blades@2/css', '') | split('|')) %}
{% endif %}

{% set content_for_header %}
  <meta name="generator" content="{{ site.generator }}">
  <style>
    object { vertical-align: middle } /*TODO: move to blades.css */
    body > footer {
      text-align: center; padding-bottom: 3rem; font-size: medium;
      object { vertical-align: text-top; border-radius: 2px; margin-inline: 0.25ch }
    }
  </style>
{% endset %}

{% block body %}
  <nav class="container">
    <ul><li><a href="/"><i class='fa-brands fa-square-build-awesome-stroke fa-xl'></i></a></li></ul>
    {{ collections.all | eleventyNavigation | eleventyNavigationToHtml | safe }}
  </nav>
  <main class="container breakout-all">
    {% if title %}<h1>{{ title }}</h1>{% endif %}
    {% if description %}<p><big>{{ description }}</big></p>{% endif %}
    {{ content | safe }}
  </main>
  <hr>
  <footer>{{ site.footer | safe }} © {{ site.year }}</footer>
{% endblock %}
